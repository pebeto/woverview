#!/usr/bin/env bash
# Prints the version that follows $1 (like v1.2.3), given the messages of
# the commits since then on stdin.
#
# Conventional Commits decide how big the step is: a "!" after the type
# ("feat!: ...") or a "BREAKING CHANGE:" line bumps the major version,
# "feat: ..." bumps the minor one, and anything else bumps the patch.
set -euo pipefail

IFS=. read -r major minor patch <<< "${1#v}"
log=$(cat)

if grep -qE '^[a-z]+(\([^)]*\))?!:|^BREAKING[ -]CHANGE:' <<< "$log"; then
    echo "$((major + 1)).0.0"
elif grep -qE '^feat(\([^)]*\))?:' <<< "$log"; then
    echo "$major.$((minor + 1)).0"
else
    echo "$major.$minor.$((patch + 1))"
fi
